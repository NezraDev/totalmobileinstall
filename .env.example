# All VITE_ values are public and are embedded in the production build.
# Set this to the HTTPS URL of the separately managed contact integration.
VITE_CONTACT_ENDPOINT=

# Public CARTO Basemaps key. CARTO tiles activate when this key is set.
# Restrict it to the final website hostnames and use a separate key for localhost.
VITE_CARTO_API_KEY=

# Exact shop pin supplied by the business. These optional overrides must be a pair.
# Both coordinates are longitude, latitude overrides for the confirmed shop pin.
VITE_MAP_LONGITUDE=-90.02540735889556
VITE_MAP_LATITUDE=30.025471630757778

# Final canonical website origin. Leave empty until the domain is confirmed.
VITE_SITE_URL=

# NEVER add a Resend sending credential to this frontend repository.
# RESEND_API_KEY and verified sender identity belong only to the external endpoint.
