# All VITE_ values are public and are embedded in the production build.
# Production requests use the same-origin Netlify Function at /api/contact.
# For local development only, optionally point at npm run start:email on localhost.
VITE_CONTACT_ENDPOINT=

# Public CARTO Basemaps key. CARTO tiles activate when this key is set.
# Restrict it to the final website hostnames and use a separate key for localhost.
VITE_CARTO_API_KEY=

# Exact shop pin supplied by the business. These optional overrides must be a pair.
# Both coordinates are longitude, latitude overrides for the confirmed shop pin.
VITE_MAP_LONGITUDE=-90.09014810481109
VITE_MAP_LATITUDE=29.961365651200683

# Optional custom HTTPS origin; defaults to the existing deployed Site URL.
VITE_SITE_URL=

# Optional public HTML verification token from Search Console (not an API key).
VITE_GOOGLE_SITE_VERIFICATION=

# The server fixes the Resend sender to amartin@totalmobileglass.com.
# NEVER add a Resend sending credential here. Configure RESEND_API_KEY and optional ALLOWED_ORIGINS
# in Netlify's server environment settings (Functions scope).
