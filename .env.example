# All VITE_ values are public and are embedded in the production build.
# Set this to the HTTPS URL of the separately managed contact integration.
VITE_CONTACT_ENDPOINT=

# Public CARTO Basemaps browser key, restricted to your final website hostnames.
# Use a separate key for localhost. This is not a CARTO platform secret token.
VITE_CARTO_API_KEY=

# Set both only after the business verifies its exact shop location.
# Census address-range research is documented in INTEGRATIONS.md.
VITE_MAP_LONGITUDE=
VITE_MAP_LATITUDE=

# Final canonical website origin. Leave empty until the domain is confirmed.
VITE_SITE_URL=

# NEVER add a Resend sending credential to this frontend repository.
# RESEND_API_KEY and verified sender identity belong only to the external endpoint.
